{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vgselect-service",
      "runtimeExecutable": "${workspaceFolder}/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "vgselect3a.service.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "port": 8765,
      "env": {
        "VGSELECT_SCAN_ROOTS": "."
      }
    }
  ]
}